{
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://server.motaa.net/seo/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "destination": "https://server.motaa.net/seo/llms.txt"
    },
    {
      "source": "/((?!assets/|sw\\.js$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
