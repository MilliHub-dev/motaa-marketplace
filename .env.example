# Copy to .env (local) and set the same variables in your host (e.g. Vercel →
# Project → Settings → Environment Variables). All Vite client vars must be
# prefixed VITE_. Everything here ships to the browser: only PUBLIC keys, never
# secret keys (those belong on the backend).

# "true" defaults the API/chat to localhost:8000.
VITE_DEBUG=false

# Backend REST API base URL, no trailing slash.
VITE_API_URL=https://server.motaa.net/api/v1
# Optional websocket origin for live chat; defaults to the API host (wss:// for https).
VITE_WS_URL=

# "true" shows logged-out visitors the maintenance dialog instead of the app
# (login, signup, about, features, business, support and legal pages stay open).
# Off by default.
VITE_MAINTENANCE_MODE=false

# Mapbox public token (pk.…) for maps. Optional: the app ships with a default.
VITE_MAPBOX_TOKEN=
# Photon geocoder for address search. Optional: defaults to https://photon.komoot.io
VITE_PHOTON_URL=

# Paystack PUBLIC key. Use the test key (pk_test_...) outside production.
VITE_PAYSTACK_PUBLIC_KEY=

# Firebase web app config (Google sign-in). Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Dojah KYC (business verification): public key plus one app + widget per business type.
VITE_DOJAH_PUBLIC_KEY=
VITE_DOJAH_DEALER_APP_ID=
VITE_DOJAH_DEALER_WIDGET_ID=
VITE_DOJAH_MECHANIC_APP_ID=
VITE_DOJAH_MECHANIC_WIDGET_ID=
