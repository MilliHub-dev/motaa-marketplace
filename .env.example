# Copy to .env and fill in. All Vite client vars must be prefixed VITE_.
# Anything here ships to the browser — never put secret keys in this file.

# Set to "true" to point chat at ws://localhost:8000 and use test payment keys.
VITE_DEBUG=false

# Dojah KYC (business/dealer verification) — src/components/index.jsx
VITE_DOJAH_LIVE_PUBLIC_KEY=
VITE_DOJAH_BIZ_DEALER_WIDGET_ID=

# Google Maps JS API key - src/App.jsx, src/components/maps.jsx
VITE_GOOGLE_MAPS_API_KEY=

# Paystack public key — src/components/wallet.jsx
VITE_PAYSTACK_LIVE_PUBLIC_KEY=
